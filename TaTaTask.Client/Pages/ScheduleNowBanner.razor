@using TaTaTask.Client.Services
@using TaTaTask.Models.Dtos
@inject IScheduleService ScheduleService
@inject IJSRuntime JS
@implements IAsyncDisposable

@* 到点提醒：页面内通栏 + 浏览器系统通知（§6.4） *@

@if (_entry is not null)
{
    <MudPaper Class="pa-2 mb-2" Elevation="1" Style="border-left:4px solid var(--mud-palette-primary);">
        <div class="d-flex align-center" style="gap:8px; flex-wrap:wrap;">
            <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Style="flex:1; min-width:140px;">
                该做 <b>@_entry.Title</b> 了 · @_entry.TimeLabel · 还剩 @RemainText()
            </MudText>
            @if (OnOpen.HasDelegate)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="OnOpen">去处理</MudButton>
            }
        </div>
    </MudPaper>
}
else if (_notifySupported && !_notifyGranted)
{
    <div class="d-flex justify-end mb-1">
        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Notifications"
                   OnClick="RequestPermissionAsync">开启到点通知</MudButton>
    </div>
}

@code {
    /// <summary>点「去处理」时的动作（看板页用来打开今日日程抽屉）。</summary>
    [Parameter] public EventCallback OnOpen { get; set; }

    private TodayScheduleDto? _today;
    private ScheduleEntryDto? _entry;
    private CancellationTokenSource? _cts;
    private IJSObjectReference? _module;
    private bool _notifySupported;
    private bool _notifyGranted;

    /// <summary>已提醒过的「日期#条目」，避免同一时段反复弹通知。</summary>
    private readonly HashSet<string> _fired = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        _cts = new CancellationTokenSource();
        _ = Task.Run(async () =>
        {
            while (!_cts.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(TimeSpan.FromSeconds(60), _cts.Token);
                    await InvokeAsync(async () =>
                    {
                        await LoadAsync();
                        await MaybeNotifyAsync();
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException)
                {
                    return;
                }
                catch
                {
                    // 后台刷新失败不打扰用户
                }
            }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 预渲染阶段没有 JS，必须等可交互后再做互操作
        if (!firstRender || !RendererInfo.IsInteractive) return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/schedule-notify.js");
            _notifySupported = await _module.InvokeAsync<bool>("isSupported");
            _notifyGranted = await _module.InvokeAsync<bool>("isGranted");
            await MaybeNotifyAsync();
            StateHasChanged();
        }
        catch
        {
            // 通知能力不可用（非安全上下文等）时静默降级为页面内提醒
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _today = await ScheduleService.GetTodayAsync();
            _entry = _today.Entries.FirstOrDefault(e => e.Id == _today.CurrentEntryId);
        }
        catch
        {
            // 读不到就让通栏空着，不打扰
        }
    }

    private string RemainText()
    {
        if (_today is null || _entry is null) return string.Empty;

        var span = _entry.EndTime.ToTimeSpan() - _today.NowTime.ToTimeSpan();
        if (span.TotalMinutes < 1) return "不到 1 分钟";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours} 小时 {span.Minutes} 分钟";
        return $"{(int)span.TotalMinutes} 分钟";
    }

    private async Task MaybeNotifyAsync()
    {
        if (_module is null || !_notifyGranted || _today is null || _entry is null) return;

        var key = $"{_today.Date:yyyy-MM-dd}#{_entry.Id}";
        if (!_fired.Add(key)) return;

        try
        {
            await _module.InvokeVoidAsync("notify", "TaTaTask 日程",
                $"该做「{_entry.Title}」了（{_entry.TimeLabel}）", $"还剩 {RemainText()}");
        }
        catch
        {
            // 通知失败不影响页面
        }
    }

    private async Task RequestPermissionAsync()
    {
        if (_module is null) return;
        try
        {
            var result = await _module.InvokeAsync<string>("requestPermission");
            _notifyGranted = string.Equals(result, "granted", StringComparison.OrdinalIgnoreCase);
            await MaybeNotifyAsync();
        }
        catch
        {
            _notifyGranted = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { /* 忽略 */ }
        }
    }
}
