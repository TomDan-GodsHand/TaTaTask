@page "/archive"
@rendermode InteractiveAuto
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using TaTaTask.Client.Services
@using TaTaTask.Models.Dtos
@using TaTaTask.Models.Enums
@attribute [Authorize]
@inject ITodoService TodoService
@inject IScheduleService ScheduleService
@inject NavigationManager Nav

<PageTitle>归档</PageTitle>

<MudPaper Class="pa-3 mb-4">
    <div class="d-flex flex-wrap align-end" style="gap:12px;">
        <MudTextField @bind-Value="_q" Label="标题关键词" Margin="Margin.Dense" Style="max-width:200px;" />
        <MudTextField @bind-Value="_tag" Label="标签" Margin="Margin.Dense" Style="max-width:160px;" />
        <div>
            <label class="mud-input-label" style="font-size:.75rem;">起始(归档日)</label>
            <InputDate Type="InputDateType.Date" @bind-Value="_from" class="form-control" />
        </div>
        <div>
            <label class="mud-input-label" style="font-size:.75rem;">截止(归档日)</label>
            <InputDate Type="InputDateType.Date" @bind-Value="_to" class="form-control" />
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Load">筛选</MudButton>
        <MudButton Variant="Variant.Text" OnClick="Reset">重置</MudButton>
    </div>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">没有符合条件的归档任务。</MudAlert>
}
else
{
    <MudSimpleTable Hover="true" Dense="true">
        <thead>
            <tr>
                <th>标题</th>
                <th>标签</th>
                <th>优先级</th>
                <th>完成时间</th>
                <th>归档时间</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in _items)
            {
                <tr Style="cursor:pointer;" @onclick="() => OpenDetail(t)">
                    <td>@t.Title</td>
                    <td>@t.Tags</td>
                    <td>@PriorityLabel(t.Priority)</td>
                    <td>@t.DoneAt?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@t.ArchivedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                       aria-label="查看详情" OnClick="@(() => OpenDetail(t))" />
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@* ==================== 日程历史（§7） ==================== *@
<MudDivider Class="my-4" />

<div class="d-flex align-center mb-2" style="gap:8px; flex-wrap:wrap;">
    <MudText Typo="Typo.h6">
        <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Small" Class="mr-1" /> 日程历史
    </MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">日期范围与上方筛选一致</MudText>
    @if (_ruleFilterLabel is not null)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                 OnClose="ClearRuleFilter" CloseIcon="@Icons.Material.Filled.Close">
            只看规则：@_ruleFilterLabel
        </MudChip>
    }
</div>

@if (_history.Count == 0)
{
    <MudAlert Severity="Severity.Info">这段时间没有日程记录。</MudAlert>
}
else
{
    @foreach (var day in _history)
    {
        <MudPaper Class="pa-2 mb-2" Elevation="1">
            <div class="d-flex align-center" style="gap:8px; flex-wrap:wrap;">
                <MudText Typo="Typo.subtitle2" Style="min-width:96px;">@day.Date.ToString("yyyy-MM-dd")</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">完成 @day.Completed</MudChip>
                @if (day.Skipped > 0)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">跳过 @day.Skipped</MudChip>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary">共 @day.AllCount 条</MudText>
            </div>

            @foreach (var e in day.Entries)
            {
                <div class="d-flex align-center mt-1" style="gap:6px; flex-wrap:wrap;">
                    <MudText Typo="Typo.caption" Style="min-width:84px; font-weight:600;">@e.TimeLabel</MudText>
                    <MudText Typo="Typo.body2" Style="flex:1; min-width:100px;">@e.Title</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@e.RuleTitle</MudText>
                    @if (e.TotalSteps > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@e.DoneSteps/@e.TotalSteps 步</MudText>
                    }
                    <MudChip T="string" Size="Size.Small" Color="@StateColor(e)">@StateLabel(e)</MudChip>
                </div>
            }
        </MudPaper>
    }
}

@if (_detail is not null)
{
    <div style="position:fixed; inset:0; background-color:rgba(0,0,0,0.5); z-index:9990;" @onclick="CloseDetail"></div>
    <div style="position:fixed; inset:0; z-index:9991; display:flex; align-items:center; justify-content:center; padding:16px; pointer-events:none;">
        <MudPaper Class="pa-5" Elevation="8" Style="width:520px; max-width:100%; max-height:90vh; overflow-y:auto; pointer-events:auto;">
            <div class="d-flex align-center justify-space-between mb-3">
                <MudText Typo="Typo.h6">任务详情</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseDetail" />
            </div>

            <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@_detail.Title</b></MudText>

            <div class="d-flex flex-wrap mb-2" style="gap:8px 24px;">
                <div>
                    <div class="mud-input-label" style="font-size:.75rem;">优先级</div>
                    <div>@PriorityLabel(_detail.Priority)</div>
                </div>
                <div>
                    <div class="mud-input-label" style="font-size:.75rem;">标签</div>
                    <div>@(_detail.Tags ?? "—")</div>
                </div>
                <div>
                    <div class="mud-input-label" style="font-size:.75rem;">创建时间</div>
                    <div>@_detail.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
                <div>
                    <div class="mud-input-label" style="font-size:.75rem;">截止时间</div>
                    <div>@(_detail.DueDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</div>
                </div>
                <div>
                    <div class="mud-input-label" style="font-size:.75rem;">完成时间</div>
                    <div>@(_detail.DoneAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</div>
                </div>
                <div>
                    <div class="mud-input-label" style="font-size:.75rem;">归档时间</div>
                    <div>@_detail.ArchivedAt?.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_detail.Description))
            {
                <div class="mb-3">
                    <div class="mud-input-label" style="font-size:.75rem;">描述</div>
                    <MudPaper Elevation="0" Class="pa-2"
                              Style="border:1px solid var(--mud-palette-lines-default); border-radius:4px; white-space:pre-wrap;">
                        @_detail.Description
                    </MudPaper>
                </div>
            }

            <div>
                <div class="mud-input-label" style="font-size:.75rem;">步骤（@_detail.Steps.Count）</div>
                @if (_detail.Steps.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mt-1">无步骤</MudText>
                }
                else
                {
                    <div class="mt-1" style="display:flex; flex-direction:column; gap:4px;">
                        @foreach (var s in _detail.Steps)
                        {
                            <div class="d-flex align-center" style="gap:6px;">
                                <MudIcon Icon="@(s.IsCompleted ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                                         Size="Size.Small"
                                         Color="@(s.IsCompleted ? Color.Success : Color.Default)" />
                                <MudText Typo="Typo.body2">@s.Title</MudText>
                                @if (s.DueDate.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Class="ml-auto">@s.DueDate.Value.ToString("yyyy-MM-dd HH:mm")</MudText>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="d-flex justify-end mt-3">
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="CloseDetail">关闭</MudButton>
            </div>
        </MudPaper>
    </div>
}

@code {
    private List<TodoItemDto> _items = new();
    private TodoItemDto? _detail;

    private List<ScheduleHistoryDto> _history = new();
    private string? _ruleFilterLabel;
    private int? _loadedRule;
    private bool _initialized;

    /// <summary>看板折叠组的「查看全部」带过来的规则筛选（§6.6 → §7）。</summary>
    [SupplyParameterFromQuery(Name = "rule")]
    public int? RuleParam { get; set; }

    private void OpenDetail(TodoItemDto item) => _detail = item;

    private void CloseDetail() => _detail = null;
    private string? _q;
    private string? _tag;
    private DateTime? _from;
    private DateTime? _to;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _from = DateTime.Today.AddDays(-7);
        _to = DateTime.Today;
        _loadedRule = RuleParam;
        _initialized = true;
        await Load();
    }

    protected override async Task OnParametersSetAsync()
    {
        // 从看板跳进来 / 点掉规则筛选时，查询参数会变，需要重新载入
        if (_initialized && _loadedRule != RuleParam)
        {
            _loadedRule = RuleParam;
            await Load();
        }
    }

    private async Task Load()
    {
        _loading = true;
        try
        {
            _items = await TodoService.GetArchivedAsync(_tag, _from, _to, _q);

            var from = DateOnly.FromDateTime(_from ?? DateTime.Today.AddDays(-7));
            var to = DateOnly.FromDateTime(_to ?? DateTime.Today);
            _history = await ScheduleService.GetHistoryAsync(from, to, RuleParam);

            _ruleFilterLabel = RuleParam is null
                ? null
                : _history.SelectMany(d => d.Entries).Select(e => e.RuleTitle).FirstOrDefault()
                  ?? $"#{RuleParam}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ClearRuleFilter() => Nav.NavigateTo("archive");

    private static string StateLabel(ScheduleEntryDto e)
    {
        if (e.State != ScheduleEntryState.Completed && e.IsTaskDeleted && e.TodoItemId is null)
        {
            return "任务已删除";
        }

        return e.State switch
        {
            ScheduleEntryState.Completed => "已完成",
            ScheduleEntryState.Skipped => "已跳过",
            ScheduleEntryState.Pending => "待选",
            _ => "未完成",
        };
    }

    private static Color StateColor(ScheduleEntryDto e) => e.State switch
    {
        ScheduleEntryState.Completed => Color.Success,
        ScheduleEntryState.Skipped => Color.Default,
        ScheduleEntryState.Pending => Color.Info,
        _ => e.IsTaskDeleted ? Color.Error : Color.Warning,
    };

    private async Task Reset()
    {
        _q = null;
        _tag = null;
        _from = DateTime.Today.AddDays(-7);
        _to = DateTime.Today;
        await Load();
    }

    private static string PriorityLabel(int priority) => priority switch
    {
        1 => "!",
        2 => "!!",
        3 => "!!!",
        4 => "!!!!",
        _ => string.Empty,
    };
}
