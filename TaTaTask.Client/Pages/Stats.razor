@page "/stats"
@rendermode InteractiveAuto
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using TaTaTask.Client.Services
@using TaTaTask.Models.Dtos
@attribute [Authorize]
@inject ITodoService TodoService
@inject IScheduleService ScheduleService
@inject NavigationManager Nav

<PageTitle>数据统计</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

<div class="stats-page">
    <MudText Typo="Typo.h5" Class="mb-4"><b>数据统计</b></MudText>

    @if (_stats.DoneLast30 == 0 && _stats.DoneThisWeek == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">
            还没有完成记录。完成任务后，这里会出现你的产出节奏、效率与精力分布回顾。
        </MudAlert>
    }

    <div class="stats-cards">
        <MudPaper Class="stats-card" Elevation="2">
            <MudText Typo="Typo.caption" Style="opacity:.7;">本周完成</MudText>
            <MudText Typo="Typo.h4" Color="Color.Success"><b>@_stats.DoneThisWeek</b></MudText>
            <div class="stats-card-sub @WeekDeltaClass()">@WeekDelta()</div>
        </MudPaper>

        <MudPaper Class="stats-card" Elevation="2">
            <MudText Typo="Typo.caption" Style="opacity:.7;">近30天完成</MudText>
            <MudText Typo="Typo.h4" Color="Color.Primary"><b>@_stats.DoneLast30</b></MudText>
            <div class="stats-card-sub">近30天累计产出</div>
        </MudPaper>

        <MudPaper Class="stats-card" Elevation="2">
            <MudText Typo="Typo.caption" Style="opacity:.7;">平均周期</MudText>
            @if (_stats.AvgCycleDays is double cycle)
            {
                <MudText Typo="Typo.h4" Color="Color.Primary"><b>@CycleLabel(cycle)</b></MudText>
                <div class="stats-card-sub">创建 → 完成（近30天）</div>
            }
            else
            {
                <MudText Typo="Typo.h4" Style="opacity:.35;"><b>—</b></MudText>
                <div class="stats-card-sub">暂无样本</div>
            }
        </MudPaper>

        <MudPaper Class="stats-card" Elevation="2">
            <MudText Typo="Typo.caption" Style="opacity:.7;">准时率</MudText>
            @{
                var dueSamples = _stats.OnTimeDoneCount + _stats.OverdueDoneCount;
            }
            @if (dueSamples > 0)
            {
                var onTimePct = (int)(_stats.OnTimeDoneCount * 100.0 / dueSamples);
                <MudText Typo="Typo.h4" Color="@(onTimePct >= 50 ? Color.Success : Color.Warning)"><b>@onTimePct%</b></MudText>
                <div class="stats-card-sub">
                    @dueSamples 个带截止日样本@(_stats.AvgOverdueDays is double od ? $" · 平均逾期 {od:0.#} 天" : "")
                </div>
            }
            else
            {
                <MudText Typo="Typo.h4" Style="opacity:.35;"><b>—</b></MudText>
                <div class="stats-card-sub">暂无样本</div>
            }
        </MudPaper>

        <MudPaper Class="stats-card" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Error" Style="opacity:.7;">逾期任务</MudText>
            <MudText Typo="Typo.h4" Color="@(_stats.OverdueCount > 0 ? Color.Error : Color.Success)"><b>@_stats.OverdueCount</b></MudText>
            <div class="stats-card-sub">@(_stats.OverdueCount > 0 ? "见下方明细" : "无逾期 ✓")</div>
        </MudPaper>
    </div>

    <div class="stats-panels">
        <div class="stats-panel">
            <div class="d-flex align-center mb-3" style="gap:12px;">
                <MudText Typo="Typo.subtitle1">
                    <MudIcon Icon="@Icons.Material.Filled.SwapVert" Size="Size.Small" Class="mr-1" /> 近8周 新增 vs 完成
                </MudText>
                <span class="legend-item"><span class="legend-dot legend-dot-created"></span>新增</span>
                <span class="legend-item"><span class="legend-dot legend-dot-done"></span>完成</span>
            </div>
            @{
                var flowMax = Math.Max(1, _stats.WeeklyFlow.Count > 0 ? _stats.WeeklyFlow.Max(w => Math.Max(w.Created, w.Done)) : 1);
            }
            <div class="flow-rows">
                @foreach (var w in _stats.WeeklyFlow)
                {
                    <div class="flow-row">
                        <div class="flow-week @(w.IsCurrent ? "flow-week-current" : "")">
                            @(w.IsCurrent ? "本周" : w.WeekLabel)
                        </div>
                        <div class="flow-bars">
                            <div class="flow-track"><div class="flow-bar flow-bar-created" style="width:@((int)(w.Created * 100.0 / flowMax))%"></div></div>
                            <div class="flow-track"><div class="flow-bar flow-bar-done" style="width:@((int)(w.Done * 100.0 / flowMax))%"></div></div>
                        </div>
                        <div class="flow-nums">
                            <span class="flow-num flow-num-created">+@w.Created</span>
                            <span class="flow-num flow-num-done">@w.Done</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="stats-panel">
            <MudText Typo="Typo.subtitle1" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Alarm" Size="Size.Small" Class="mr-1" /> 逾期明细
            </MudText>
            @if (_stats.OverdueItems.Count == 0)
            {
                <div class="empty-hint">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" Class="mr-1" />
                    当前没有逾期任务，保持！
                </div>
            }
            else
            {
                <div class="overdue-list">
                    @foreach (var o in _stats.OverdueItems)
                    {
                        <div class="overdue-item" style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo("tatatask"))">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Error" Class="mr-1" />
                                <MudText Typo="Typo.body2" Style="flex:1;">@o.Title</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">逾期 @o.DaysOverdue 天</MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Style="opacity:.6; margin-left:28px;">截止 @o.DueDate.ToString("MM/dd HH:mm")</MudText>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="stats-panels">
        <div class="stats-panel">
            <MudText Typo="Typo.subtitle1" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" Class="mr-1" /> 标签分布（活跃任务）
            </MudText>
            @{
                var tagMax = Math.Max(1, _stats.TagCounts.Count > 0 ? _stats.TagCounts.Max(t => t.Count) : 1);
            }
            @if (_stats.TagCounts.Count == 0)
            {
                <div class="empty-hint">活跃任务暂无标签</div>
            }
            else
            {
                <div class="dist-rows">
                    @foreach (var t in _stats.TagCounts)
                    {
                        <div class="dist-row">
                            <span class="dist-label" title="@t.Tag">@t.Tag</span>
                            <div class="dist-track"><div class="dist-bar" style="width:@((int)(t.Count * 100.0 / tagMax))%"></div></div>
                            <span class="dist-num">@t.Count</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="stats-panel">
            <MudText Typo="Typo.subtitle1" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Small" Class="mr-1" /> 优先级分布（活跃任务）
            </MudText>
            @{
                var prioLabels = new[] { "无", "!", "!!", "!!!", "!!!!" };
                var prioTotal = _stats.PriorityCounts.Sum();
                var prioMax = Math.Max(1, _stats.PriorityCounts.DefaultIfEmpty(0).Max());
            }
            @if (prioTotal == 0)
            {
                <div class="empty-hint">暂无活跃任务</div>
            }
            else
            {
                <div class="dist-rows">
                    @for (var p = 0; p < _stats.PriorityCounts.Length; p++)
                    {
                        if (_stats.PriorityCounts[p] == 0) { continue; }
                        <div class="dist-row">
                            <span class="dist-label">@prioLabels[p]</span>
                            <div class="dist-track"><div class="dist-bar dist-bar-priority" style="width:@((int)(_stats.PriorityCounts[p] * 100.0 / prioMax))%"></div></div>
                            <span class="dist-num">@_stats.PriorityCounts[p]</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="stats-panel stats-panel-block">
        <MudText Typo="Typo.subtitle1" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.HourglassBottom" Size="Size.Small" Class="mr-1" /> 老化任务（创建最久未完成）
        </MudText>
        @if (_stats.AgingItems.Count == 0)
        {
            <div class="empty-hint">暂无活跃任务</div>
        }
        else
        {
            <div class="aging-list">
                @foreach (var a in _stats.AgingItems)
                {
                    <div class="aging-item @(a.AgeDays >= 14 ? "aging-warn" : "")" style="cursor:pointer;"
                         @onclick="@(() => Nav.NavigateTo("tatatask"))">
                        <MudIcon Icon="@(a.AgeDays >= 14 ? Icons.Material.Filled.Warning : Icons.Material.Filled.Schedule)"
                                 Size="Size.Small" Color="@(a.AgeDays >= 14 ? Color.Error : Color.Default)" Class="mr-1" />
                        <MudText Typo="Typo.body2" Style="flex:1;">@a.Title</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@(a.AgeDays >= 14 ? Color.Error : Color.Default)">已 @a.AgeDays 天</MudChip>
                    </div>
                }
            </div>
        }
    </div>

    @* ==================== 日程执行（并入本页，不新开页面） ==================== *@
    <MudDivider Class="my-4" />

    <MudText Typo="Typo.h6" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.Today" Size="Size.Small" Class="mr-1" /> 日程执行
    </MudText>

    @if (!_schedule.HasData)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">
            还没有日程记录。去「日程」页加一条周规则后，这里会显示执行率、全勤天数与哪条规则排得不合理。
        </MudAlert>
    }
    else
    {
        <div class="stats-cards">
            <MudPaper Class="stats-card" Elevation="2">
                <MudText Typo="Typo.caption" Style="opacity:.7;">今日完成</MudText>
                @if (_schedule.TodayPlanned == 0)
                {
                    <MudText Typo="Typo.h4" Style="opacity:.35;"><b>—</b></MudText>
                    <div class="stats-card-sub">今天没有安排</div>
                }
                else
                {
                    <MudText Typo="Typo.h4" Color="@(_schedule.TodayRate >= 100 ? Color.Success : Color.Primary)">
                        <b>@_schedule.TodayDone/@_schedule.TodayPlanned</b>
                    </MudText>
                    <div class="stats-card-sub">完成率 @_schedule.TodayRate%</div>
                }
            </MudPaper>

            <MudPaper Class="stats-card" Elevation="2">
                <MudText Typo="Typo.caption" Style="opacity:.7;">近30天完成率</MudText>
                @if (_schedule.Last30Planned == 0)
                {
                    <MudText Typo="Typo.h4" Style="opacity:.35;"><b>—</b></MudText>
                    <div class="stats-card-sub">暂无样本</div>
                }
                else
                {
                    <MudText Typo="Typo.h4" Color="@(_schedule.Last30Rate >= 80 ? Color.Success : Color.Warning)">
                        <b>@_schedule.Last30Rate%</b>
                    </MudText>
                    <div class="stats-card-sub @ScheduleDeltaClass()">@ScheduleDelta()</div>
                }
            </MudPaper>

            <MudPaper Class="stats-card" Elevation="2">
                <MudText Typo="Typo.caption" Style="opacity:.7;">连续全勤</MudText>
                <MudText Typo="Typo.h4" Color="@(_schedule.StreakDays > 0 ? Color.Success : Color.Default)">
                    <b>@_schedule.StreakDays 天</b>
                </MudText>
                <div class="stats-card-sub">有安排且全部完成；没安排的日子不算断</div>
            </MudPaper>

            <MudPaper Class="stats-card" Elevation="2">
                <MudText Typo="Typo.caption" Style="opacity:.7;">日均排期</MudText>
                @if (_schedule.AvgDailyMinutes == 0)
                {
                    <MudText Typo="Typo.h4" Style="opacity:.35;"><b>—</b></MudText>
                    <div class="stats-card-sub">暂无样本</div>
                }
                else
                {
                    <MudText Typo="Typo.h4" Color="Color.Primary">
                        <b>@((_schedule.AvgDailyMinutes / 60.0).ToString("0.#")) 小时</b>
                    </MudText>
                    <div class="stats-card-sub">近30天，按有安排的天数平均</div>
                }
            </MudPaper>
        </div>

        <div class="stats-panels">
            <div class="stats-panel">
                <div class="d-flex align-center mb-3" style="gap:12px;">
                    <MudText Typo="Typo.subtitle1">
                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" Class="mr-1" /> 近8周 排定 vs 完成
                    </MudText>
                    <span class="legend-item"><span class="legend-dot legend-dot-created"></span>排定</span>
                    <span class="legend-item"><span class="legend-dot legend-dot-done"></span>完成</span>
                </div>
                @{
                    var execMax = Math.Max(1, _schedule.WeeklyExecution.Count > 0
                        ? _schedule.WeeklyExecution.Max(w => Math.Max(w.Planned, w.Done)) : 1);
                }
                <div class="flow-rows">
                    @foreach (var w in _schedule.WeeklyExecution)
                    {
                        <div class="flow-row">
                            <div class="flow-week @(w.IsCurrent ? "flow-week-current" : "")">
                                @(w.IsCurrent ? "本周" : w.WeekLabel)
                            </div>
                            <div class="flow-bars">
                                <div class="flow-track"><div class="flow-bar flow-bar-created" style="width:@((int)(w.Planned * 100.0 / execMax))%"></div></div>
                                <div class="flow-track"><div class="flow-bar flow-bar-done" style="width:@((int)(w.Done * 100.0 / execMax))%"></div></div>
                            </div>
                            <div class="flow-nums">
                                <span class="flow-num flow-num-created">@w.Planned</span>
                                <span class="flow-num flow-num-done">@w.Done</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="stats-panel">
                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Rule" Size="Size.Small" Class="mr-1" /> 规则执行榜（近30天）
                </MudText>
                @if (_schedule.Rules.Count == 0)
                {
                    <div class="empty-hint">近 30 天没有规则排期记录</div>
                }
                else
                {
                    @foreach (var r in _schedule.Rules)
                    {
                        <div class="d-flex align-center mb-2" style="gap:8px;">
                            <MudText Typo="Typo.body2" title="@r.TimeLabel"
                                     Style="flex:1; min-width:70px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@r.Title</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@r.ModeLabel</MudChip>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="min-width:88px;">@r.TimeLabel</MudText>
                            <div style="width:110px; height:6px; border-radius:3px; background:var(--mud-palette-action-disabled-background); overflow:hidden;">
                                <div style="height:100%; width:@(r.Rate)%; background:var(--mud-palette-primary);"></div>
                            </div>
                            <MudText Typo="Typo.caption" Style="min-width:78px; text-align:right;">
                                @RateText(r)
                            </MudText>
                        </div>
                        @if (r.Planned > 0 && r.Skipped > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="margin-left:4px;">（其中跳过 @r.Skipped 次）</MudText>
                        }
                    }
                }
            </div>
        </div>

        @if (_schedule.Insight is not null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3" Icon="@Icons.Material.Filled.Lightbulb">
                @_schedule.Insight
            </MudAlert>
        }
    }
</div>

@code {
    private DashboardStatsDto _stats = new();
    private ScheduleStatsDto _schedule = new();
    private bool _loading;
    private string? _error;
    private HubConnection? _hub;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _stats = await TodoService.GetStatsAsync();
            _schedule = await ScheduleService.GetStatsAsync();
        }
        catch (Exception ex)
        {
            _error = $"统计数据加载失败: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _hub = new HubConnectionBuilder()
                    .WithUrl(Nav.ToAbsoluteUri("/hubs/todo"))
                    .Build();
                _hub.On("Refresh", async () =>
                {
                    _stats = await TodoService.GetStatsAsync();
                    _schedule = await ScheduleService.GetStatsAsync();
                    await InvokeAsync(StateHasChanged);
                });
                await _hub.StartAsync();
            }
            catch (Exception ex)
            {
                _error = $"实时连接失败: {ex.Message}";
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
            await _hub.DisposeAsync();
    }

    private string WeekDelta() => (_stats.DoneThisWeek, _stats.DoneLastWeek) switch
    {
        (var t, var l) when t > l => $"较上周 +{t - l}",
        (var t, var l) when t < l => $"较上周 −{l - t}",
        _ => "与上周持平",
    };

    private string WeekDeltaClass() => (_stats.DoneThisWeek, _stats.DoneLastWeek) switch
    {
        (var t, var l) when t > l => "delta-up",
        (var t, var l) when t < l => "delta-down",
        _ => "",
    };

    private static string CycleLabel(double days)
    {
        if (days < 1) return "<1 天";
        return $"{days:0.#} 天";
    }

    private string ScheduleDelta() => _schedule.Last30Delta switch
    {
        > 0 => $"较上一个30天 +{_schedule.Last30Delta} 个百分点",
        < 0 => $"较上一个30天 {_schedule.Last30Delta} 个百分点",
        _ => "与上一个30天持平",
    };

    private string ScheduleDeltaClass() => _schedule.Last30Delta switch
    {
        > 0 => "delta-up",
        < 0 => "delta-down",
        _ => "",
    };

    private static string RateText(RulePerformanceDto r)
        => r.Planned > 0 ? $"{r.Done}/{r.Planned} · {r.Rate}%" : $"跳过 {r.Skipped} 次";
}
