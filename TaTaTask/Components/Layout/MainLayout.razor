@inherits LayoutComponentBase
@inject NavigationManager Nav

<MudThemeProvider Theme="@_theme" IsDarkMode="false" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
            <a href="tatatask" class="d-flex align-center" style="text-decoration:none;">
            <img src="img/logo.png" alt="TaTaTask" style="height:48px;" />
        </a>
        <MudSpacer />
        <AuthorizeView>
            <Authorized Context="authState">
                <MudButton Href="tatatask" Variant="Variant.Text"
                           Color="@(IsActive("tatatask") ? Color.Primary : Color.Inherit)"
                           Style="@(IsActive("tatatask") ? "font-weight:bold;" : null)"
                           StartIcon="@Icons.Material.Filled.Dashboard" Class="nav-btn mr-1"><span class="nav-btn-label">看板</span></MudButton>
                <MudButton Href="archive" Variant="Variant.Text"
                           Color="@(IsActive("archive") ? Color.Primary : Color.Inherit)"
                           Style="@(IsActive("archive") ? "font-weight:bold;" : null)"
                           StartIcon="@Icons.Material.Filled.Archive" Class="nav-btn mr-1"><span class="nav-btn-label">归档</span></MudButton>
                <MudButton Href="stats" Variant="Variant.Text"
                           Color="@(IsActive("stats") ? Color.Primary : Color.Inherit)"
                           Style="@(IsActive("stats") ? "font-weight:bold;" : null)"
                           StartIcon="@Icons.Material.Filled.BarChart" Class="nav-btn mr-1"><span class="nav-btn-label">统计</span></MudButton>
                <MudButton Href="feedback" Variant="Variant.Text"
                           Color="@(IsActive("feedback") ? Color.Primary : Color.Inherit)"
                           Style="@(IsActive("feedback") ? "font-weight:bold;" : null)"
                           StartIcon="@Icons.Material.Filled.Feedback" Class="nav-btn mr-3"><span class="nav-btn-label">反馈</span></MudButton>
                <details class="user-menu">
                    <summary class="user-menu-summary">
                        @authState.User.Identity?.Name <span class="user-menu-arrow">▾</span>
                    </summary>
                    <MudPaper Elevation="8" Class="user-dropdown">
                        <MudMenuItem Href="/settings">设置</MudMenuItem>
                        <MudDivider Class="my-1" />
                        <MudMenuItem Href="/Account/Logout">登出</MudMenuItem>
                    </MudPaper>
                </details>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="feedback" Variant="Variant.Text"
                           Color="@(IsActive("feedback") ? Color.Primary : Color.Inherit)"
                           Style="@(IsActive("feedback") ? "font-weight:bold;" : null)"
                           StartIcon="@Icons.Material.Filled.Feedback" Class="nav-btn mr-2"><span class="nav-btn-label">反馈</span></MudButton>
                <MudLink Href="login" Color="Color.Inherit">登录</MudLink>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="content-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<AuthorizeView>
    <Authorized>
        <div class="mobile-nav">
            <MudPaper Elevation="4" Class="mobile-nav-paper">
                <MudIconButton Href="tatatask" Icon="@Icons.Material.Filled.Dashboard"
                               Color="@(IsActive("tatatask") ? Color.Primary : Color.Inherit)"
                               title="看板" Class="mobile-nav-item" />
                <MudIconButton Href="archive" Icon="@Icons.Material.Filled.Archive"
                               Color="@(IsActive("archive") ? Color.Primary : Color.Inherit)"
                               title="归档" Class="mobile-nav-item" />
                <MudIconButton Href="stats" Icon="@Icons.Material.Filled.BarChart"
                               Color="@(IsActive("stats") ? Color.Primary : Color.Inherit)"
                               title="统计" Class="mobile-nav-item" />
                <MudIconButton Href="feedback" Icon="@Icons.Material.Filled.Feedback"
                               Color="@(IsActive("feedback") ? Color.Primary : Color.Inherit)"
                               title="反馈" Class="mobile-nav-item" />
                <MudIconButton Href="settings" Icon="@Icons.Material.Filled.Settings"
                               Color="@(IsActive("settings") ? Color.Primary : Color.Inherit)"
                               title="设置" Class="mobile-nav-item" />
            </MudPaper>
        </div>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#10C8A3",
            Secondary = "#0E9E82",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1B4332",
        },
    };

    private bool IsActive(string page)
        => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').Equals("/" + page, StringComparison.OrdinalIgnoreCase);

    private void Logout()
    {
        Nav.NavigateTo("/Account/Logout", forceLoad: true);
    }
}
