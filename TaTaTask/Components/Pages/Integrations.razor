@page "/integrations"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using TaTaTask.Data
@using TaTaTask.External
@using TaTaTask.Models.Entities
@using TaTaTask.Services
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>外部接入</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h5" Class="mb-4">外部接入</MudText>
        <MudText Class="mb-4">为其他网页、脚本或 AI agent 创建独立访问令牌。每个令牌只访问你的数据，撤销后立即失效。</MudText>
        <MudText Typo="Typo.body2">Web API：<code>@(Navigation.BaseUri.TrimEnd('/') + "/api/v1")</code></MudText>
        <MudText Typo="Typo.body2" Class="mb-4">MCP（Streamable HTTP）：<code>@(Navigation.BaseUri.TrimEnd('/') + "/mcp")</code></MudText>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">客户端通过 Authorization: Bearer 发送令牌。每个应用使用单独的令牌；请勿把令牌写进公开网页源码。跨站网页需要管理员配置允许来源。</MudAlert>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }
        @if (_secret is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mb-3">令牌已创建。完整令牌只在这里显示一次，请现在保存；刷新页面后无法再次查看。</MudAlert>
            <MudTextField T="string" Value="_secret" ReadOnly="true" Label="完整访问令牌" Variant="Variant.Outlined" Class="mb-3" />
            <MudButton OnClick="@(() => _secret = null)" Class="mb-4">已保存，隐藏令牌</MudButton>
        }

        <MudText Typo="Typo.h6" Class="mb-3">创建令牌</MudText>
        <MudTextField T="string" @bind-Value="_name" Label="名称，例如个人主页或 Codex" MaxLength="80" Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField T="int" @bind-Value="_days" Label="有效期（天）" Min="1" Max="365" Variant="Variant.Outlined" Class="mb-3" />
        <MudCheckBox T="bool" @bind-Value="_canWrite" Label="允许写入（创建、修改和删除任务及日程规则）" />
        <MudText Typo="Typo.caption" Class="mb-3">默认只读。查询仍会执行应用已有的自动归档与今日日程生成。</MudText>
        <MudButton OnClick="Create" Disabled="_busy" Color="Color.Primary" Variant="Variant.Filled" Class="mt-3 mb-6">创建访问令牌</MudButton>

        <MudDivider Class="mb-4" />
        <MudText Typo="Typo.h6" Class="mb-3">访问令牌</MudText>
        @if (_tokens.Count == 0)
        {
            <MudText>还没有访问令牌。</MudText>
        }
        @foreach (var token in _tokens)
        {
            var active = token.RevokedAt is null && token.ExpiresAt > DateTime.UtcNow;
            <MudPaper Outlined="true" Class="pa-4 mb-3" @key="token.Id">
                <MudText Typo="Typo.subtitle1">@token.Name</MudText>
                <MudText Typo="Typo.body2">@(token.CanWrite ? "读写" : "只读") · @(token.RevokedAt is not null ? "已撤销" : active ? "有效" : "已过期") · @token.Prefix…</MudText>
                <MudText Typo="Typo.caption">到期时间：@UserTime.ToUser(token.ExpiresAt, _timeZone).ToString("yyyy-MM-dd HH:mm")（@_timeZone.Id）</MudText>
                @if (active)
                {
                    <MudButton OnClick="@(() => Revoke(token.Id))" Disabled="_busy" Color="Color.Error" Size="Size.Small" Class="mt-2">撤销</MudButton>
                }
            </MudPaper>
        }
    </MudPaper>
</MudContainer>

@code {
    private List<ApiToken> _tokens = [];
    private string _name = "";
    private int _days = 90;
    private bool _canWrite;
    private bool _busy;
    private int _userId;
    private string? _secret;
    private string? _error;
    private TimeZoneInfo _timeZone = TimeZoneInfo.Utc;

    protected override async Task OnInitializedAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        if (!int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out _userId)) return;
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var tz = await db.Users.Where(u => u.Id == _userId).Select(u => u.TimeZoneId).SingleAsync();
        _timeZone = UserTime.Resolve(tz);
        _tokens = await scope.ServiceProvider.GetRequiredService<ApiTokenStore>().ListAsync(_userId);
    }

    private async Task Create()
    {
        if (_busy || _userId == 0) return;
        _busy = true;
        _error = null;
        _secret = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var store = scope.ServiceProvider.GetRequiredService<ApiTokenStore>();
            _secret = await store.CreateAsync(_userId, _name, _canWrite, _days);
            _tokens = await store.ListAsync(_userId);
            _name = "";
        }
        catch (ArgumentException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Revoke(int id)
    {
        if (_busy || _userId == 0) return;
        _busy = true;
        _secret = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var store = scope.ServiceProvider.GetRequiredService<ApiTokenStore>();
            await store.RevokeAsync(_userId, id);
            _tokens = await store.ListAsync(_userId);
        }
        finally { _busy = false; }
    }
}
